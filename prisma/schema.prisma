generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String    @id @default(cuid())
  googleId     String    @unique
  email        String    @unique
  name         String
  avatarUrl    String?
  createdAt    DateTime  @default(now())
  lastSyncedAt DateTime?

  member           HouseholdMember?
  salaryCycles     SalaryCycle[]
  transactions     Transaction[]
  streaks          Streak[]
  xpEvents         XpEvent[]
  debts            Debt[]
  merchants        Merchant[]
  accounts         Account[]
  categories       Category[]
}

model Household {
  id         String   @id @default(cuid())
  inviteCode String   @unique
  createdAt  DateTime @default(now())

  members           HouseholdMember[]
  goals             Goal[]
  committedExpenses CommittedExpense[]
}

model HouseholdMember {
  id          String   @id @default(cuid())
  householdId String
  userId      String   @unique
  role        String   @default("member") // owner | member
  joinedAt    DateTime @default(now())

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SalaryCycle {
  id        Int      @id @default(autoincrement())
  userId    String
  month     Int
  year      Int
  income    Float
  salaryDay Int      @default(1)
  startDate DateTime
  createdAt DateTime @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@unique([userId, month, year])
}

model Transaction {
  id            Int      @id @default(autoincrement())
  userId        String
  salaryCycleId Int?
  amount        Float
  category      String
  date          DateTime
  type          String
  notes         String?
  source        String   @default("manual")
  refNo         String?
  rawMessage    String?
  accountLast4  String?
  bankName      String?
  tags          String?
  merchantKey   String?
  createdAt     DateTime @default(now())

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  salaryCycle SalaryCycle? @relation(fields: [salaryCycleId], references: [id])
}

// Normalized merchant/counterparty with the user's learned name + category.
model Merchant {
  id          Int      @id @default(autoincrement())
  userId      String
  rawKey      String
  displayName String
  category    String   @default("other")
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, rawKey])
}

// Bank/card auto-created from captured messages.
model Account {
  id          Int      @id @default(autoincrement())
  userId      String
  bankName    String
  last4       String?
  type        String   @default("other")
  displayName String?
  hidden      Boolean  @default(false)
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// User-created custom categories.
model Category {
  id         Int      @id @default(autoincrement())
  userId     String
  name       String
  emoji      String   @default("🏷️")
  colorValue Float    @default(4280791162)
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
}

model CommittedExpense {
  id          Int      @id @default(autoincrement())
  householdId String
  name        String
  amount      Float
  category    String
  isRecurring Boolean  @default(true)
  frequency   String   @default("monthly")
  createdAt   DateTime @default(now())

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
}

model Goal {
  id                   Int      @id @default(autoincrement())
  householdId          String
  name                 String
  targetAmount         Float
  currentAmount        Float    @default(0)
  monthlyContribution  Float    @default(0)
  emoji                String   @default("🎯")
  createdAt            DateTime @default(now())

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
}

model Streak {
  id              Int       @id @default(autoincrement())
  userId          String
  type            String
  currentCount    Int       @default(0)
  bestCount       Int       @default(0)
  lastCheckinDate DateTime?
  createdAt       DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model XpEvent {
  id          Int      @id @default(autoincrement())
  userId      String
  eventType   String
  xpEarned    Int
  description String
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Debt {
  id             Int      @id @default(autoincrement())
  userId         String
  name           String
  originalAmount Float
  currentBalance Float
  monthlyPayment Float
  interestRate   Float    @default(0)
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
